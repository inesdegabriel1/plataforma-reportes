# Copia este fichero como backend/.env y rellénalo. El .env NUNCA se sube a GitHub.

# 1 = datos sintéticos de prueba (sin base de datos). 0 = base de datos real.
DEMO=0

# Conexión MySQL (los mismos datos que usas en HeidiSQL; mejor un usuario de solo lectura)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=qar

# Generados con: .venv\Scripts\python.exe hash_password.py
# Pega las líneas tal cual las imprime el script (sin comillas).
APP_PASSWORD_HASH=
JWT_SECRET=
TOKEN_HOURS=8

# Orígenes web permitidos: la web local y la de GitHub Pages
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://inesdegabriel1.github.io
SERVE_FRONTEND=1

# Reglas de negocio (compruébalas en HeidiSQL)
FLIGHT_TIME_UNIT=min
CANCELLED_VALUES=S,SI,Y,1,X
REQUIRE_FLIGHT_TIME=1
STOP_DAYS=30
CACHE_SECONDS=600
